# Student Mart Backend Configuration
# For Local Development (Default):
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/student_mart
JWT_SECRET=student_mart_secret_key_college_project_2026
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: Customize Default Admin Account (Auto-created on first boot)
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=admin123

# ==========================================================
# For Production Deployment on Render + Aiven MongoDB:
# ==========================================================
# PORT=10000 (Render sets PORT automatically)
# MONGO_URI=mongodb+srv://avnadmin:<PASSWORD>@<AIVEN-HOST>/student_mart?authSource=admin&tls=true
# JWT_SECRET=<any-long-random-secret-key>
# CLIENT_URL=https://<your-vercel-app>.vercel.app
# NODE_ENV=production
# ADMIN_EMAIL=admin@campus.edu
# ADMIN_PASSWORD=<your-secure-admin-password>
